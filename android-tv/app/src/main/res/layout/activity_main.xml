<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/sideContainer"
            android:layout_width="292dp"
            android:layout_height="match_parent"
            android:background="@color/panel">

            <LinearLayout
                android:id="@+id/navPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="14dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginBottom="14dp"
                    android:contentDescription="CDA"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/ic_launcher"/>

                <Button
                    android:id="@+id/browse"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/button_bg"
                    android:text="Przeglądaj"
                    android:textColor="@color/text"/>

                <Button
                    android:id="@+id/recent"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/button_bg"
                    android:text="Ostatnio oglądane"
                    android:textColor="@color/text"/>

                <Button
                    android:id="@+id/favorites"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/button_bg"
                    android:text="Ulubione"
                    android:textColor="@color/text"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:text="Szukaj ręcznie"
                    android:textColor="@color/muted"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/manualQuery"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/button_bg"
                    android:hint="np. lektor 1988"
                    android:imeOptions="actionSearch"
                    android:paddingHorizontal="10dp"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="#6F7783"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/manualSearch"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_bg"
                        android:text="Szukaj"
                        android:textColor="@color/text"/>

                    <ImageButton
                        android:id="@+id/voiceSearch"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/button_bg"
                        android:contentDescription="Wyszukiwanie głosowe"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_mic"/>
                </LinearLayout>

                <Button
                    android:id="@+id/settingsButton"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/button_bg"
                    android:text="⚙ Ustawienia"
                    android:textColor="@color/text"/>

                <Space
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="Gotowe"
                    android:textColor="@color/muted"
                    android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/detailPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/detailThumb"
                    android:layout_width="match_parent"
                    android:layout_height="145dp"
                    android:background="#252A33"
                    android:scaleType="centerCrop"/>

                <TextView
                    android:id="@+id/detailTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="3"
                    android:paddingTop="6dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/detailTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="0dp"
                    android:textColor="@color/muted"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/detailRating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="3dp"
                    android:textColor="#FFD22E"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"/>

                <LinearLayout
                    android:id="@+id/detailActions"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="2dp"
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/detailFavorite"
                        android:layout_width="42dp"
                        android:layout_height="40dp"
                        android:background="@drawable/button_bg"
                        android:contentDescription="Dodaj do ulubionych"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_favorite_border"/>

                    <ImageButton
                        android:id="@+id/detailDescription"
                        android:layout_width="42dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/button_bg"
                        android:contentDescription="Opis"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_info"/>

                    <ImageButton
                        android:id="@+id/detailComments"
                        android:layout_width="42dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/button_bg"
                        android:contentDescription="Komentarze"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_comments"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/detailDescriptionPreview"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:maxLines="18"
                    android:paddingTop="5dp"
                    android:textColor="@color/text"
                    android:textSize="12sp"/>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:id="@+id/yearFilterBar"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <HorizontalScrollView
                    android:id="@+id/yearScroll"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:fillViewport="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/yearRow"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"/>
                </HorizontalScrollView>

                <ImageButton
                    android:id="@+id/filterButton"
                    android:layout_width="46dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/button_bg"
                    android:contentDescription="Sortowanie i długość"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_filter"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/resultsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/removeCollection"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/button_bg"
                    android:textColor="#FF7B89"
                    android:textSize="11sp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/resultCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:textColor="@color/muted"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:paddingBottom="12dp"/>

            <LinearLayout
                android:id="@+id/loadingBar"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="22dp"
                    android:layout_height="22dp"/>

                <TextView
                    android:id="@+id/loadingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:textColor="@color/muted"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/contentLoadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#78000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#D015181D"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ProgressBar
                android:layout_width="38dp"
                android:layout_height="38dp"/>

            <TextView
                android:id="@+id/contentLoadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/voiceOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B8000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#E0181C22"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_mic"/>

            <TextView
                android:id="@+id/voiceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Mów…"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/securityOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0101216"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/securityTitle"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:text="Weryfikacja zabezpieczeń CDA"
            android:textColor="@color/text"
            android:textSize="19sp"
            android:textStyle="bold"/>

        <FrameLayout
            android:id="@+id/securityHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="58dp"/>
    </FrameLayout>
</FrameLayout>
